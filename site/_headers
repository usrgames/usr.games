# What a browser may load on usr.games: this site's own files, and the one script Cloudflare
# adds to each page at the edge to count visits, which reports back to this same address.
# Nothing written inside a page is run. A test holds the pages to this policy.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js/; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# A game's page plays the game, and a browser compiles the game's WebAssembly only where the
# policy says 'wasm-unsafe-eval'. Each page that plays takes the policy above off and sets it again
# with that one word more: its scripts and everything else are still this site's alone. A test
# holds every page that plays to this, and no other page.
/rustwake
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com/beacon.min.js/; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
/skyspear
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com/beacon.min.js/; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# A game's build and glonk's player are kept at addresses that carry their version, so a browser
# may keep them for good.
/play/*
  Cache-Control: public, max-age=31536000, immutable

# The two key files are text. Left alone, one has no kind at all and the other, for its ending,
# is called a Publisher document, and a browser told not to guess would only offer to save them.
/etc/allowed_signers
  Content-Type: text/plain; charset=utf-8
/etc/release-cert.pub
  Content-Type: text/plain; charset=utf-8

# The installer is read in a browser by anyone careful before it is piped to sh.
/install.sh
  Content-Type: text/plain; charset=utf-8

# A preview is a draft, at an address of Cloudflare's: search engines are told not to list it.
https://:preview.:account.workers.dev/*
  X-Robots-Tag: noindex
